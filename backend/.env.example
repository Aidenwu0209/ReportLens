# App
APP_ENV=dev
APP_BASE_URL=http://localhost:8000
APP_JWT_SECRET=change_me_please
APP_JWT_EXPIRE_MIN=120

# Storage
DATA_ROOT=./data
STORAGE_BACKEND=localfs

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=annual_ai
MYSQL_USER=annual_ai_user
MYSQL_PASSWORD=annual_ai_pass
SQLALCHEMY_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Vector Search (Optional)
QDRANT_URL=http://localhost:6333
VECTOR_BACKEND=none

# PaddleOCR-VL 1.5
PADDLEOCR_VL_API_BASE=http://localhost:9000
PADDLEOCR_VL_API_KEY=your_key
PADDLEOCR_VL_TIMEOUT_SEC=60
PADDLEOCR_VL_MAX_RPS=5

# Wenxin 5.0
WENXIN_API_BASE=https://aip.baidubce.com
WENXIN_API_KEY=your_key
WENXIN_MODEL=ernie-5.0
WENXIN_TIMEOUT_SEC=90
WENXIN_MAX_RPS=2

# Export
EXPORT_TEMPLATE_VER=tpl_001
